# Local overrides for Dhara (gitignored).
#
# Copy this file to settings/local.yaml and edit per machine.
# settings/local.yaml is gitignored - never commit your populated copy.
#
# Why this exists: settings/standard.yaml points backups at /data/dhara/backups
# (a Linux-container convention) and stores AsyncSqliteStorage URLs that include
# the maintainer's home directory. On macOS, /data is on a read-only filesystem
# and mkdir(parents=True) fails at startup, so we redirect here.
#
# Oneiric loads this AFTER settings/standard.yaml and BEFORE env vars, so any
# key set here wins over the upstream default. See:
#   docs/CONFIGURATION.md "Configuration layers"
#   oneiric docs on layered settings (settings/local.yaml overrides).

storage:
  # XDG-compliant: defaults to ~/.local/share/dhara/.
  # NOTE: Dhara's path resolver only calls .expanduser() (no expandvars), so
  # we MUST use the `~` form rather than ${HOME}.
  path: ~/.local/share/dhara/production.dhara

# Local override: standard.yaml points backups at /data/dhara/backups, which
# is a Linux-container convention. On macOS, /data is on a read-only filesystem
# and mkdir(parents=True) fails at startup. Redirect to a writable XDG path.
backups:
  directory: ~/.local/share/dhara/backups

# Local override: AsyncSqliteStorage reads from this key, NOT storage.path
# above. The hardcoded fallback in AsyncSqliteStorage.__init__ is
# "sqlite+aiosqlite:///dev/shm/dhara.db" which is Linux-only; /dev/shm does
# not exist on macOS. Use a distinct .db file because storage.path is the
# sync SHELF-1 file (not SQLite) and aiosqlite refuses to open it.
# The `~` form is the maintainer's documented path-resolver convention.
dhara:
  storage:
    sqlite:
      url: sqlite+aiosqlite:////~/.local/share/dhara/async.db
