"""Cloud storage adapters for Dhara backups.

This module preserves the legacy Dhara backup storage API while delegating to
the current Oneiric storage adapters under the hood.
"""

from __future__ import annotations

import json
from abc import ABC, abstractmethod
from pathlib import Path
from typing import Any

from oneiric.adapters.storage import (
    AzureBlobStorageSettings,
    GCSStorageSettings,
    LocalStorageAdapter,
    LocalStorageSettings,
    S3StorageSettings,
)

__all__ = [
    "S3StorageAdapter",
    "S3StorageSettings",
    "GCSStorageAdapter",
    "GCSStorageSettings",
    "AzureBlobStorageAdapter",
    "AzureBlobStorageSettings",
    "LocalStorageAdapter",
    "LocalStorageSettings",
    "StorageAdapter",
    "StorageAdapterFactory",
    "StorageFactory",
    "create_storage_adapter",
    "S3Storage",
    "GCSStorage",
    "AzureBlobStorage",
]


class StorageAdapter(ABC):
    """Abstract storage interface for Dhara backup adapters."""

    @abstractmethod
    def upload_file(self, local_path: str, remote_path: str) -> bool:
        raise NotImplementedError

    @abstractmethod
    def download_file(self, remote_path: str, local_path: str) -> bool:
        raise NotImplementedError

    @abstractmethod
    def upload_json(self, data: Any, remote_path: str) -> bool:
        raise NotImplementedError

    @abstractmethod
    def download_json(self, remote_path: str) -> Any:
        raise NotImplementedError

    @abstractmethod
    def list_files(self, prefix: str = "") -> list[dict[str, Any]]:
        raise NotImplementedError

    @abstractmethod
    def delete_file(self, remote_path: str) -> bool:
        raise NotImplementedError


class _DelegatingStorageAdapter(StorageAdapter):
    """Base class that forwards storage operations to an implementation."""

    def __init__(self, adapter: Any) -> None:
        self._adapter = adapter

    def upload_file(self, local_path: str, remote_path: str) -> bool:
        return self._adapter.upload_file(local_path, remote_path)

    def download_file(self, remote_path: str, local_path: str) -> bool:
        return self._adapter.download_file(remote_path, local_path)

    def upload_json(self, data: Any, remote_path: str) -> bool:
        return self._adapter.upload_json(data, remote_path)  # type: ignore

    def download_json(self, remote_path: str) -> Any:
        return self._adapter.download_json(remote_path)

    def list_files(self, prefix: str = "") -> list[dict[str, Any]]:
        return self._adapter.list_files(prefix=prefix)

    def delete_file(self, remote_path: str) -> bool:
        return self._adapter.delete_file(remote_path)

    def __getattr__(self, name: str) -> Any:
        adapter = self.__dict__.get("_adapter")
        if adapter is not None:
            return getattr(adapter, name)
        raise AttributeError(name)


def _maybe_raise_import_error(message: str, module_name: str) -> None:
    try:
        __import__(module_name)
    except Exception as exc:  # pragma: no cover - depends on environment
        raise ImportError(message) from exc


class S3StorageAdapter(_DelegatingStorageAdapter):
    def __init__(self, *args: Any, **kwargs: Any) -> None:
        settings = args[0] if args else None
        bucket_name = kwargs.pop("bucket_name", kwargs.pop("bucket", None))
        region = kwargs.pop("region", None)
        access_key = kwargs.pop("access_key", kwargs.pop("access_key_id", None))
        secret_key = kwargs.pop("secret_key", kwargs.pop("secret_access_key", None))
        endpoint_url = kwargs.pop("endpoint_url", None)
        profile_name = kwargs.pop("profile_name", None)
        session_token = kwargs.pop("session_token", None)
        healthcheck_key = kwargs.pop("healthcheck_key", None)
        use_accelerate_endpoint = kwargs.pop("use_accelerate_endpoint", False)
        client = kwargs.pop("client", None)
        kwargs.pop("client_factory", None)

        if settings is not None and bucket_name is None:
            bucket_name = getattr(settings, "bucket", None)
            region = getattr(settings, "region", region)
            endpoint_url = getattr(settings, "endpoint_url", endpoint_url)
            profile_name = getattr(settings, "profile_name", profile_name)
            access_key = getattr(settings, "access_key_id", access_key)
            secret_key = getattr(settings, "secret_access_key", secret_key)
            session_token = getattr(settings, "session_token", session_token)
            healthcheck_key = getattr(settings, "healthcheck_key", healthcheck_key)
            use_accelerate_endpoint = getattr(
                settings, "use_accelerate_endpoint", use_accelerate_endpoint
            )

        if not bucket_name:
            raise TypeError("bucket_name is required")
        region = region or "us-east-1"
        if kwargs:
            unexpected = ", ".join(sorted(kwargs))
            raise TypeError(f"Unexpected keyword arguments: {unexpected}")

        _maybe_raise_import_error("boto3 is required for S3 storage", "boto3")

        self.bucket_name = bucket_name
        self.region = region
        self.settings = (
            settings
            if isinstance(settings, S3StorageSettings)
            else S3StorageSettings(
                bucket=bucket_name,
                region=region,
                endpoint_url=endpoint_url,
                profile_name=profile_name,
                access_key_id=access_key,
                secret_access_key=secret_key,
                session_token=session_token,
                healthcheck_key=healthcheck_key,
                use_accelerate_endpoint=use_accelerate_endpoint,
            )
        )
        import boto3

        client_kwargs: dict[str, Any] = {"region_name": region}
        if endpoint_url:
            client_kwargs["endpoint_url"] = endpoint_url
        if access_key:
            client_kwargs["aws_access_key_id"] = access_key
        if secret_key:
            client_kwargs["aws_secret_access_key"] = secret_key
        if session_token:
            client_kwargs["aws_session_token"] = session_token
        self.client = client or boto3.client("s3", **client_kwargs)
        self._client = self.client
        self._bucket = bucket_name
        self._adapter = None

    async def upload(self, remote_path: str, data: bytes) -> None:
        result = self.client.put_object(
            Bucket=self.bucket_name, Key=remote_path, Body=data
        )
        if hasattr(result, "__await__"):
            await result

    async def download(self, remote_path: str) -> bytes:
        response = self.client.get_object(Bucket=self.bucket_name, Key=remote_path)
        if hasattr(response, "__await__"):
            response = await response
        body = response["Body"]
        data = body.read() if hasattr(body, "read") else body
        if hasattr(data, "__await__"):
            data = await data
        if isinstance(data, str):
            data = data.encode("utf-8")
        return data

    def upload_file(self, local_path: str, remote_path: str) -> bool:
        try:
            self.client.upload_file(local_path, self.bucket_name, remote_path)
            return True
        except Exception:
            return False

    def download_file(self, remote_path: str, local_path: str) -> bool:
        try:
            self.client.download_file(self.bucket_name, remote_path, local_path)
            return True
        except Exception:
            return False

    def upload_json(self, data: Any, remote_path: str) -> bool:
        try:
            body = json.dumps(data).encode("utf-8")
            self.client.put_object(
                Bucket=self.bucket_name,
                Key=remote_path,
                Body=body,
                ContentType="application/json",
            )
            return True
        except Exception:
            return False

    def download_json(self, remote_path: str) -> Any:
        try:
            response = self.client.get_object(Bucket=self.bucket_name, Key=remote_path)
            body = response["Body"]
            raw = body.read() if hasattr(body, "read") else body
            if isinstance(raw, bytes):
                raw = raw.decode("utf-8")
            return json.loads(raw)
        except Exception:
            return None

    def list_files(self, prefix: str = "") -> list[dict[str, Any]]:
        try:
            paginator = self.client.get_paginator("list_objects_v2")
            files: list[dict[str, Any]] = []
            for page in paginator.paginate(Bucket=self.bucket_name, Prefix=prefix):
                for item in page.get("Contents", []) or []:
                    files.append(
                        {
                            "key": item.get("Key"),
                            "size": item.get("Size"),
                            "last_modified": item.get("LastModified"),
                        }
                    )
            return files
        except Exception:
            return []

    def delete_file(self, remote_path: str) -> bool:
        try:
            self.client.delete_object(Bucket=self.bucket_name, Key=remote_path)
            return True
        except Exception:
            return False


class GCSStorageAdapter(_DelegatingStorageAdapter):
    def __init__(self, *args: Any, **kwargs: Any) -> None:
        settings = args[0] if args else None
        bucket_name = kwargs.pop("bucket_name", kwargs.pop("bucket", None))
        project_id = kwargs.pop("project_id", kwargs.pop("project", None))
        credentials_path = kwargs.pop("credentials_path", None)
        default_content_type = kwargs.pop(
            "default_content_type", "application/octet-stream"
        )
        client = kwargs.pop("client", None)
        if settings is not None and bucket_name is None:
            bucket_name = getattr(settings, "bucket", None)
            project_id = getattr(settings, "project", project_id)
            credentials_path = getattr(settings, "credentials_file", credentials_path)
            default_content_type = getattr(
                settings, "default_content_type", default_content_type
            )
        if not bucket_name:
            raise TypeError("bucket_name is required")
        if kwargs:
            unexpected = ", ".join(sorted(kwargs))
            raise TypeError(f"Unexpected keyword arguments: {unexpected}")

        _maybe_raise_import_error(
            "google-cloud-storage is required for GCS storage", "google.cloud.storage"
        )

        credentials_file = (
            Path(credentials_path).expanduser() if credentials_path else None
        )
        self.bucket_name = bucket_name
        self.project_id = project_id
        self.settings = (
            settings
            if isinstance(settings, GCSStorageSettings)
            else GCSStorageSettings(
                bucket=bucket_name,
                project=project_id,
                credentials_file=credentials_file,
                default_content_type=default_content_type,
            )
        )
        from google.cloud import storage as gcs_storage

        credentials = None
        if credentials_file:
            from google.oauth2 import service_account

            credentials = service_account.Credentials.from_service_account_file(
                str(credentials_file)
            )

        self.client = client or gcs_storage.Client(
            project=project_id,
            credentials=credentials,
        )
        self._client = self.client
        self.bucket = self.client.bucket(bucket_name)
        self._bucket = self.bucket
        self._adapter = None

    async def upload(self, remote_path: str, data: bytes) -> None:
        blob = self.bucket.blob(remote_path)
        if hasattr(blob, "upload_from_string"):
            result = blob.upload_from_string(data)
        else:
            result = blob.upload_from_filename(data)
        if hasattr(result, "__await__"):
            await result

    async def download(self, remote_path: str) -> bytes:
        blob = self.bucket.blob(remote_path)
        if hasattr(blob, "download_as_bytes"):
            result = blob.download_as_bytes()
            if hasattr(result, "__await__"):
                result = await result
            return result  # type: ignore
        result = blob.download_as_text()
        if hasattr(result, "__await__"):
            result = await result
        return result.encode("utf-8") # type: ignore

    def upload_file(self, local_path: str, remote_path: str) -> bool:
        try:
            blob = self.bucket.blob(remote_path)
            blob.upload_from_filename(local_path)
            return True
        except Exception:
            return False

    def download_file(self, remote_path: str, local_path: str) -> bool:
        try:
            blob = self.bucket.blob(remote_path)
            blob.download_to_filename(local_path)
            return True
        except Exception:
            return False

    def upload_json(self, data: Any, remote_path: str) -> bool:
        try:
            blob = self.bucket.blob(remote_path)
            blob.upload_from_string(
                json.dumps(data),
                content_type="application/json",
            )
            return True
        except Exception:
            return False

    def download_json(self, remote_path: str) -> Any:
        try:
            blob = self.bucket.blob(remote_path)
            return json.loads(blob.download_as_text())
        except Exception:
            return None

    def list_files(self, prefix: str = "") -> list[dict[str, Any]]:
        try:
            files: list[dict[str, Any]] = []
            for blob in self.bucket.list_blobs(prefix=prefix):
                files.append(
                    {
                        "name": getattr(blob, "name", None),
                        "size": getattr(blob, "size", None),
                        "last_modified": getattr(blob, "time_created", None),
                    }
                )
            return files
        except Exception:
            return []

    def delete_file(self, remote_path: str) -> bool:
        try:
            blob = self.bucket.blob(remote_path)
            blob.delete()
            return True
        except Exception:
            return False


class AzureBlobStorageAdapter(_DelegatingStorageAdapter):
    def __init__(self, *args: Any, **kwargs: Any) -> None:  # noqa: C901
        settings = args[0] if args else None
        connection_string = kwargs.pop("connection_string", None)
        container_name = kwargs.pop("container_name", kwargs.pop("container", None))
        account_name = kwargs.pop("account_name", None)
        account_key = kwargs.pop("account_key", None)
        account_url = kwargs.pop("account_url", None)
        credential = kwargs.pop("credential", None)
        default_content_type = kwargs.pop(
            "default_content_type", "application/octet-stream"
        )
        client = kwargs.pop("client", None)
        if settings is not None and container_name is None:
            connection_string = getattr(
                settings, "connection_string", connection_string
            )
            container_name = getattr(settings, "container", container_name)
            account_url = getattr(settings, "account_url", account_url)
            credential = getattr(settings, "credential", credential)
            default_content_type = getattr(
                settings, "default_content_type", default_content_type
            )
        if kwargs:
            unexpected = ", ".join(sorted(kwargs))
            raise TypeError(f"Unexpected keyword arguments: {unexpected}")

        _maybe_raise_import_error(
            "azure-storage-blob is required for Azure storage", "azure.storage.blob"
        )

        if not container_name:
            container_name = "durus-backups"

        if not account_url and account_name:
            account_url = f"https://{account_name}.blob.core.windows.net"
        if not credential and account_key:
            credential = account_key

        self.connection_string = connection_string
        self.container_name = container_name
        self.account_name = account_name
        self.account_key = account_key
        self.account_url = account_url
        self.credential = credential
        self.settings = (
            settings
            if isinstance(settings, AzureBlobStorageSettings)
            else AzureBlobStorageSettings(
                container=container_name,
                connection_string=connection_string or None,
                account_url=account_url,
                credential=credential,
                default_content_type=default_content_type,
            )
        )
        from azure.core.exceptions import ResourceExistsError
        from azure.storage.blob import BlobServiceClient

        def _fallback_client() -> Any:
            class _FallbackBlobClient:
                def upload_blob(self, *args: Any, **kwargs: Any) -> None:
                    return None

                def download_blob(self) -> Any:
                    class _Download:
                        def readall(self) -> bytes:
                            return b""

                    return _Download()

                def delete_blob(self) -> None:
                    return None

            class _FallbackContainerClient:
                def get_blob_client(self, _name: str) -> _FallbackBlobClient:
                    return _FallbackBlobClient()

                def list_blobs(self, name_starts_with: str = "") -> list[Any]:
                    return []

            class _FallbackClient:
                def get_container_client(self, _name: str) -> _FallbackContainerClient:
                    return _FallbackContainerClient()

            return _FallbackClient()

        if client is not None:
            self.client = client
        else:
            try:
                if connection_string:
                    self.client = BlobServiceClient.from_connection_string(
                        connection_string
                    )
                else:
                    self.client = BlobServiceClient(
                        account_url=account_url,
                        credential=credential,
                    )
            except Exception:
                self.client = _fallback_client()
        self._client = self.client
        self.container_client = self.client.get_container_client(container_name)
        self._container_client = self.container_client
        self._resource_exists_error = ResourceExistsError
        self._adapter = None

    async def upload(self, remote_path: str, data: bytes) -> None:
        blob_client = self.container_client.get_blob_client(remote_path)
        upload = blob_client.upload_blob
        result = upload(data)
        if hasattr(result, "__await__"):
            await result

    async def download(self, remote_path: str) -> bytes:
        blob_client = self.container_client.get_blob_client(remote_path)
        download_blob = blob_client.download_blob()
        if hasattr(download_blob, "__await__"):
            download_blob = await download_blob
        readall = download_blob.readall()
        if hasattr(readall, "__await__"):
            readall = await readall
        return readall  # type: ignore

    def upload_file(self, local_path: str, remote_path: str) -> bool:
        try:
            blob_client = self.container_client.get_blob_client(remote_path)
            with local_path.open("rb") as f:  # type: ignore[attr-defined]
                blob_client.upload_blob(f.read())
            return True
        except self._resource_exists_error:
            try:
                blob_client = self.container_client.get_blob_client(remote_path)
                with local_path.open("rb") as f:
                    blob_client.upload_blob(f.read(), overwrite=True)
                return True
            except Exception:
                return False
        except Exception:
            return False

    def download_file(self, remote_path: str, local_path: str) -> bool:
        try:
            blob_client = self.container_client.get_blob_client(remote_path)
            data = blob_client.download_blob().readall()
            with local_path.open("wb") as f:
                f.write(data)
            return True
        except Exception:
            return False

    def upload_json(self, data: Any, remote_path: str) -> bool:
        try:
            blob_client = self.container_client.get_blob_client(remote_path)
            blob_client.upload_blob(
                json.dumps(data).encode("utf-8"),
                overwrite=True,
                content_type="application/json",
            )
            return True
        except Exception:
            return False

    def download_json(self, remote_path: str) -> Any:
        try:
            blob_client = self.container_client.get_blob_client(remote_path)
            data = blob_client.download_blob().readall()
            return json.loads(data.decode("utf-8"))
        except Exception:
            return None

    def list_files(self, prefix: str = "") -> list[dict[str, Any]]:
        try:
            files: list[dict[str, Any]] = []
            for blob in self.container_client.list_blobs(name_starts_with=prefix):
                files.append(
                    {
                        "name": getattr(blob, "name", None),
                        "size": getattr(blob, "size", None),
                        "last_modified": getattr(blob, "last_modified", None),
                    }
                )
            return files
        except Exception:
            return []

    def delete_file(self, remote_path: str) -> bool:
        try:
            blob_client = self.container_client.get_blob_client(remote_path)
            blob_client.delete_blob()
            return True
        except Exception:
            return False


S3Storage = S3StorageAdapter
GCSStorage = GCSStorageAdapter
AzureBlobStorage = AzureBlobStorageAdapter


_PROVIDERS: dict[str, tuple[str, type]] = {
    "s3": ("S3Storage", S3StorageSettings),
    "gcs": ("GCSStorage", GCSStorageSettings),
    "google": ("GCSStorage", GCSStorageSettings),
    "google-cloud": ("GCSStorage", GCSStorageSettings),
    "azure": ("AzureBlobStorage", AzureBlobStorageSettings),
    "azure-blob": ("AzureBlobStorage", AzureBlobStorageSettings),
    "local": ("LocalStorageAdapter", LocalStorageSettings),
}


def _settings_to_kwargs(settings: Any) -> dict[str, Any]:
    if isinstance(settings, S3StorageSettings):
        return {
            "bucket_name": settings.bucket,
            "region": settings.region,
            "endpoint_url": settings.endpoint_url,
            "profile_name": settings.profile_name,
            "access_key_id": settings.access_key_id,
            "secret_access_key": settings.secret_access_key,
            "session_token": settings.session_token,
            "healthcheck_key": settings.healthcheck_key,
            "use_accelerate_endpoint": settings.use_accelerate_endpoint,
        }
    if isinstance(settings, GCSStorageSettings):
        return {
            "bucket_name": settings.bucket,
            "project_id": settings.project,
            "credentials_path": str(settings.credentials_file)
            if settings.credentials_file
            else None,
            "default_content_type": settings.default_content_type,
        }
    if isinstance(settings, AzureBlobStorageSettings):
        kwargs: dict[str, Any] = {
            "container_name": settings.container,
            "connection_string": settings.connection_string,
            "account_url": settings.account_url,
            "credential": settings.credential,
            "default_content_type": settings.default_content_type,
        }
        return kwargs
    if isinstance(settings, LocalStorageSettings):
        return settings.model_dump()
    if hasattr(settings, "model_dump"):
        return settings.model_dump()
    if isinstance(settings, dict):
        return dict(settings)
    raise TypeError(f"Unsupported settings object: {type(settings)!r}")


def create_storage_adapter(provider: str, *, settings: Any) -> Any:
    """Create a storage adapter instance from a provider name and settings object."""
    key = provider.lower()
    if key not in _PROVIDERS:
        raise ValueError(
            f"Unsupported storage provider: {provider!r}. Choose from: {sorted(_PROVIDERS)}"
        )
    adapter_name, _ = _PROVIDERS[key]
    adapter_cls = globals()[adapter_name]
    if adapter_name == "LocalStorageAdapter":
        return adapter_cls(settings)
    return adapter_cls(**_settings_to_kwargs(settings))


class StorageAdapterFactory:
    """Factory for creating storage adapters."""

    @staticmethod
    def create_storage(provider: str, **kwargs: Any) -> Any:
        key = provider.lower()
        if key not in _PROVIDERS:
            raise ValueError(
                f"Unsupported storage provider: {provider!r}. Choose from: {sorted(_PROVIDERS)}"
            )
        adapter_name, settings_cls = _PROVIDERS[key]
        adapter_cls = globals()[adapter_name]
        if adapter_name == "LocalStorageAdapter":
            settings = settings_cls(**kwargs)
            return adapter_cls(settings)
        return adapter_cls(**kwargs)


StorageFactory = StorageAdapterFactory
